---
// Barra superior con el tiempo en directo (Open-Meteo: gratis, sin clave, se consulta desde el navegador).
interface Props { lang: 'es' | 'ca' }
const { lang } = Astro.props;
const TOWNS = [
  ['Palma', 39.5696, 2.6502], ['Inca', 39.721, 2.911], ['Manacor', 39.5696, 3.2096], ['Sóller', 39.7667, 2.715],
  ['Alcúdia', 39.853, 3.121], ['Pollença', 39.877, 3.016], ['Artà', 39.693, 3.35], ['Felanitx', 39.469, 3.148],
  ['Llucmajor', 39.49, 2.89], ['Maó', 39.8885, 4.2658], ['Ciutadella', 40.0012, 3.8384],
  [lang === 'es' ? 'Ibiza' : 'Eivissa', 38.9067, 1.4206], ['Sant Antoni', 38.9806, 1.3036], ['Formentera', 38.7059, 1.429],
];
const L = lang === 'es'
  ? { sea: 'Mar', uv: 'UV', sunrise: 'Amanecer', sunset: 'Ocaso', uvLevels: ['Bajo', 'Moderado', 'Alto', 'Muy alto', 'Extremo'] }
  : { sea: 'Mar', uv: 'UV', sunrise: 'Sortida del sol', sunset: 'Posta', uvLevels: ['Baix', 'Moderat', 'Alt', 'Molt alt', 'Extrem'] };
---
<div class="infobar" aria-label={lang === 'es' ? 'El tiempo en Baleares' : 'El temps a les Balears'}>
  <div class="marquee" data-weather data-towns={JSON.stringify(TOWNS)} data-l={JSON.stringify(L)}>
    <div class="marquee-track">
      <div class="marquee-group">
        {TOWNS.map(([name]) => <span class="info-item"><span class="wx-icon"></span><span class="info-label">{name}</span> <b>–°</b></span>)}
      </div>
    </div>
  </div>
</div>

<script is:inline>
(() => {
  const el = document.querySelector('[data-weather]');
  if (!el) return;
  const towns = JSON.parse(el.dataset.towns);
  const L = JSON.parse(el.dataset.l);
  const ICONS = {
    sun: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>',
    partly: '<svg viewBox="0 0 24 24"><path d="M8 3v1.5M3.5 8H2M4.6 4.6l1 1M12.4 4.6l-1 1"/><path d="M5.5 10.5a3.5 3.5 0 0 1 6.6-1.6"/><path d="M17.5 19H9a4 4 0 1 1 1.2-7.8A5 5 0 0 1 19.6 13 3 3 0 0 1 17.5 19z"/></svg>',
    cloud: '<svg viewBox="0 0 24 24"><path d="M17.5 19H8a5 5 0 1 1 1.3-9.8A6 6 0 0 1 20.4 12 3.5 3.5 0 0 1 17.5 19z"/></svg>',
    fog: '<svg viewBox="0 0 24 24"><path d="M4 10h16M3 14h18M5 18h14M6 6h12"/></svg>',
    rain: '<svg viewBox="0 0 24 24"><path d="M17.5 15H8a5 5 0 1 1 1.3-9.8A6 6 0 0 1 20.4 8 3.5 3.5 0 0 1 17.5 15z"/><path d="M8 18l-1 3M12 18l-1 3M16 18l-1 3"/></svg>',
    storm: '<svg viewBox="0 0 24 24"><path d="M17.5 14H8a5 5 0 1 1 1.3-9.8A6 6 0 0 1 20.4 7 3.5 3.5 0 0 1 17.5 14z"/><path d="M12 15l-2 4h4l-2 4"/></svg>',
    snow: '<svg viewBox="0 0 24 24"><path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9"/></svg>',
    wave: '<svg viewBox="0 0 24 24"><path d="M2 8q2.5-2 5 0t5 0 5 0 5 0M2 13q2.5-2 5 0t5 0 5 0 5 0M2 18q2.5-2 5 0t5 0 5 0 5 0"/></svg>',
    uv: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.5"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"/></svg>',
    sunrise: '<svg viewBox="0 0 24 24"><path d="M5 17a7 7 0 0 1 14 0M2 17h20M12 3v5M9 6l3-3 3 3"/></svg>',
    sunset: '<svg viewBox="0 0 24 24"><path d="M5 17a7 7 0 0 1 14 0M2 17h20M12 3v5M9 5l3 3 3-3"/></svg>',
  };
  const iconFor = (c) => c === 0 ? 'sun' : c <= 2 ? 'partly' : c === 3 ? 'cloud' : c <= 48 ? 'fog' : c <= 67 || (c >= 80 && c <= 82) ? 'rain' : c <= 77 || c === 85 || c === 86 ? 'snow' : 'storm';
  const uvLevel = (u) => L.uvLevels[u < 3 ? 0 : u < 6 ? 1 : u < 8 ? 2 : u < 11 ? 3 : 4];
  const hhmm = (iso) => iso ? iso.slice(11, 16) : '';
  const item = (icon, label, value, cls = '') => `<span class="info-item ${cls}"><span class="wx-icon">${ICONS[icon]}</span><span class="info-label">${label}</span> <b>${value}</b></span>`;

  async function load() {
    const KEY = 'hb-weather-v1';
    try {
      const cached = JSON.parse(sessionStorage.getItem(KEY) || 'null');
      if (cached && Date.now() - cached.t < 20 * 60000) return cached.d;
    } catch {}
    const lat = towns.map((t) => t[1]).join(','), lon = towns.map((t) => t[2]).join(',');
    const [wx, sea] = await Promise.all([
      fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,weather_code&daily=uv_index_max,sunrise,sunset&timezone=Europe%2FMadrid&forecast_days=1`).then((r) => r.json()),
      fetch('https://marine-api.open-meteo.com/v1/marine?latitude=39.50&longitude=2.62&current=wave_height&timezone=Europe%2FMadrid').then((r) => r.json()).catch(() => null),
    ]);
    const d = { wx: [].concat(wx), sea };
    try { sessionStorage.setItem(KEY, JSON.stringify({ t: Date.now(), d })); } catch {}
    return d;
  }

  load().then(({ wx, sea }) => {
    let html = towns.map((t, i) => {
      const cur = wx[i]?.current;
      return cur ? item(iconFor(cur.weather_code), t[0], `${Math.round(cur.temperature_2m)}°`) : '';
    }).join('');
    const palma = wx[0]?.daily;
    const wave = sea?.current?.wave_height;
    if (wave != null) html += item('wave', L.sea, `${wave.toFixed(1)} m`);
    if (palma?.uv_index_max?.[0] != null) {
      const u = palma.uv_index_max[0];
      html += item('uv', L.uv, `${uvLevel(u)} (${Math.round(u)})`, u >= 6 ? 'is-warm' : '');
    }
    if (palma?.sunrise?.[0]) html += item('sunrise', L.sunrise, hhmm(palma.sunrise[0])) + item('sunset', L.sunset, hhmm(palma.sunset[0]));
    const track = el.querySelector('.marquee-track');
    track.innerHTML = `<div class="marquee-group">${html}</div><div class="marquee-group" aria-hidden="true">${html}</div>`;
    el.classList.add('is-ready');
  }).catch(() => {});
})();
</script>
