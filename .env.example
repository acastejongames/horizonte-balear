# Copia este archivo como ".env" y pon tus claves (el archivo .env NUNCA se sube a GitHub).

# IA principal — https://console.groq.com/keys
GROQ_API_KEY=pon_aqui_tu_clave_de_groq

# IA de respaldo (opcional) — https://aistudio.google.com/apikey
GEMINI_API_KEY=pon_aqui_tu_clave_de_gemini

# --- Opcional: ajustes avanzados ---
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# MAX_WRITES_PER_RUN=25          # noticias redactadas como máximo por ejecución
# SINGLE_SOURCE_DELAY_MIN=60     # minutos que se espera a que otro medio confirme antes de publicar con fuente única
# RETENTION_DAYS=30              # días en data/stories.json antes de pasar al archivo
